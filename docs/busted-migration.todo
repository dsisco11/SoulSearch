  are: `filter_action_list` 8; `filter_panel` 8; `matched_filters_panel` 1;
  `modal_panel` 3; `pointer_dispatcher` 7; `results_panel` 3;
  `tooltip_agent` 7; `widget_extensions` 5; `stats_layout` 1;
  `stats_panel` 1; `stats_popover` 7; `stats_presenter` 10;
  `stats_sort_subject` 2; `unit_stats_list` 1; `ui_format` 14;
